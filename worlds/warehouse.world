<?xml version="1.0"?>
<sdf version="1.6">
  <world name="warehouse_world">

    <!-- ═══════════════════════════════════════════════
         PHYSICS
    ═══════════════════════════════════════════════ -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ═══════════════════════════════════════════════
         SCENE LIGHTING
    ═══════════════════════════════════════════════ -->
    <scene>
      <sky><clouds><speed>12</speed></clouds></sky>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main overhead light -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Warehouse ceiling lights (point lights) -->
    <light name="ceiling_light_1" type="point">
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_2" type="point">
      <pose>5 0 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="ceiling_light_3" type="point">
      <pose>-5 0 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ═══════════════════════════════════════════════
         GROUND PLANE
    ═══════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════
         WAREHOUSE WALLS
    ═══════════════════════════════════════════════ -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.2 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.2 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>8 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 16 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 16 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-8 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 16 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 16 3.0</size></box></geometry>
          <material><script><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════
         SHELF MACRO (reused for all shelves)
         Each shelf: 2.0 x 0.5 x 1.5 m, with 3 levels
    ═══════════════════════════════════════════════ -->

    <!-- Shelf Row A (x=3) -->
    <model name="shelf_A1">
      <static>true</static>
      <pose>3 -5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.5 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.5 1.5</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_A2">
      <static>true</static>
      <pose>3 -2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.5 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.5 1.5</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_A3">
      <static>true</static>
      <pose>3 1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.5 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.5 1.5</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Shelf Row B (x=-3) -->
    <model name="shelf_B1">
      <static>true</static>
      <pose>-3 -5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.5 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.5 1.5</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_B2">
      <static>true</static>
      <pose>-3 -2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.5 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.5 1.5</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_B3">
      <static>true</static>
      <pose>-3 1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.5 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.5 1.5</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════
         ARUCO MARKER BOARDS (placed on shelf faces)
         Represented as flat panels with ArUco textures.
         In practice, use custom textures or the
         ros2_aruco_gazebo_plugin for rendered markers.
         Marker IDs: 0=TaskA, 1=TaskB, 2=TaskC, 3=TaskD
    ═══════════════════════════════════════════════ -->

    <!-- Marker 0 – Task A (shelf A1 face) -->
    <model name="aruco_marker_0">
      <static>true</static>
      <pose>3.26 -5 0.8 0 0 3.14159</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.01 0.2 0.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.01 0.2 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://warehouse_robot/materials/aruco_0.material</uri>
              <name>ArUco/Marker0</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Marker 1 – Task B (shelf B1 face) -->
    <model name="aruco_marker_1">
      <static>true</static>
      <pose>-2.74 -5 0.8 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.01 0.2 0.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.01 0.2 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://warehouse_robot/materials/aruco_1.material</uri>
              <name>ArUco/Marker1</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Marker 2 – Task C (shelf A2 face) -->
    <model name="aruco_marker_2">
      <static>true</static>
      <pose>3.26 -2 0.8 0 0 3.14159</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.01 0.2 0.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.01 0.2 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://warehouse_robot/materials/aruco_2.material</uri>
              <name>ArUco/Marker2</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Marker 3 – Task D (shelf B2 face, dynamic demo) -->
    <model name="aruco_marker_3">
      <static>true</static>
      <pose>-2.74 -2 0.8 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.01 0.2 0.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.01 0.2 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://warehouse_robot/materials/aruco_3.material</uri>
              <name>ArUco/Marker3</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════
         CHARGING STATION / HOME BASE
    ═══════════════════════════════════════════════ -->
    <model name="charging_station">
      <static>true</static>
      <pose>0 6.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 0.6 0.1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.6 0.1</size></box></geometry>
          <material><script><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════
         ROBOT SPAWN POSITION
         (handled via launch file, shown here for ref)
    ═══════════════════════════════════════════════ -->

  </world>
</sdf>
